# Flask Environment
FLASK_APP=app:create_app
FLASK_ENV=development
SECRET_KEY=change-this-to-a-secure-random-string-in-production

# Database Configuration (SQLite default for dev, MySQL for prod)
# DATABASE_URL=mysql+pymysql://agro_user:agro_pass@localhost:3306/agrovision
DATABASE_URL=sqlite:///agrovision.db

# File Upload limits (in bytes, default 5MB)
MAX_CONTENT_LENGTH=5242880

# Machine Learning thresholds
DISEASE_CONFIDENCE_THRESHOLD=0.60
